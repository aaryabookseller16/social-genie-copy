# Copy to .env.local and fill in. See docs/guides/environment-variables.md.

# --- Xano (all optional: defaults point at the production workspace) ---
# XANO_BASE_URL=https://xwpg-kuah-brlj.n7d.xano.io
# XANO_GENIE_DEV_BASE=https://xwpg-kuah-brlj.n7d.xano.io/api:pgMKWi2e
# XANO_AUTH_BASE=https://xwpg-kuah-brlj.n7d.xano.io/api:dRDS80y8
# XANO_STRIPE_BASE=https://xwpg-kuah-brlj.n7d.xano.io/api:jQf3GatY
# XANO_GENIE_VENUES_URL=https://xwpg-kuah-brlj.n7d.xano.io/api:mY7zYhwk/genie_v1

# --- OneSignal (optional: defaults to the current app ID; visible in browser) ---
# NEXT_PUBLIC_ONESIGNAL_APP_ID=2b0988a9-9a1e-4039-9131-e4859ea641e2

# --- App URLs (used to build Stripe success/cancel redirects) ---
# Defaults to https://genie.socialbevy.com. Set to http://localhost:3000 locally.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# APP_BASE_URL=

# --- Auth ---
# HMAC secret for the legacy local JWT check in /api/genie/message.
# Required whenever a request carries a Bearer token, or that route returns 500.
JWT_SECRET=change-me

# --- Google Maps (optional; venue map previews are hidden without it) ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
